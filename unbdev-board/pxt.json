{
    "name": "unbdev-board",
    "description": "UNBdev.board tutorial authoring course extension",
    "dependencies": {
        "unbdev-board": "github:UNB-ECE/pxt-unbdev-board#22ed7d76838be66d456de13efc1604b1037dbefe",
        "microphone": "*"
    },
    "files": [
        "README.md",
        "catalog.md",
        "main.ts",
        "microphone-validation.md",
        "motor-validation.md",
        "wifi-mqtt-validation.md",
        "lessons/blixel.md",
        "lessons/microphone.md",
        "lessons/motor-control.md",
        "lessons/wifi-mqtt.md",
        "static/motors.svg",
        "lessons/main.py"
    ],
    "testFiles": [
        "test.ts"
    ],
    "targetVersions": {
        "target": "9.1.1",
        "targetId": "microbit"
    },
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "config": {
            "microbit-dal": {
                "bluetooth": {
                    "open": 0,
                    "whitelist": 1,
                    "security_level": "SECURITY_MODE_ENCRYPTION_NO_MITM"
                }
            }
        }
    }
}
